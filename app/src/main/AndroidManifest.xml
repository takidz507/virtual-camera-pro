<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera & Media Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Android 11 - 16 Cross-App Package Visibility for Camera & Virtual Video Provider -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <provider android:authorities="com.takidz.vcam.provider" />
    </queries>

    <application
        android:name=".VCamApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.VCamPro"
        tools:targetApi="34">

        <!-- Metadata for optional LSPatch / Xposed compatibility -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Virtual Camera Pro v3.0 — Zero-Xposed Binder Proxy + Pine ART Hook + Camera1/Camera2/OpenCamera Full Fix" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!-- 1. Main Control Dashboard Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. NEW v3.0: Zero-Xposed & Zero-Root Binder Proxy + Pine ART Lab & Sandbox Activity -->
        <activity
            android:name=".ui.ZeroXposedLabActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize" />

        <!-- 3. System-Wide Camera Intent Responder (Works 100% without Root or Xposed when any app requests Camera Intent) -->
        <activity
            android:name=".ui.VirtualCameraCaptureActivity"
            android:exported="true"
            android:label="@string/vcam_picker_label"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 4. Built-in WebRTC Virtual Camera Browser (Injects Virtual Video into getUserMedia, enumerateDevices & File Chooser) -->
        <activity
            android:name=".ui.VirtualWebBrowserActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 5. Cross-Process ContentProvider for feeding video & live settings -->
        <provider
            android:name=".provider.VirtualVideoProvider"
            android:authorities="com.takidz.vcam.provider"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- 6. NEW v3.0: Auto-Boot Zero-Xposed Engine Provider (Initializes BinderCameraInterceptor + PineArtHookEngine before Application.onCreate) -->
        <provider
            android:name=".provider.ZeroXposedBootProvider"
            android:authorities="com.takidz.vcam.zeroxposed.boot"
            android:exported="false"
            android:initOrder="999999999" />

        <!-- 7. Floating Quick-Switch Controller Service (Switch between Real Camera & Video over any app) -->
        <service
            android:name=".service.FloatingControlService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
